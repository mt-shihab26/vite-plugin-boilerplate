{
    "type": "module",
    "name": "vite-plugin-boilerplate",
    "version": "0.3.3",
    "description": "A Vite plugin that automatically writes component boilerplate when you create a new .tsx, .jsx, or .vue file.",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/mt-shihab26/vite-plugin-boilerplate.git"
    },
    "homepage": "https://github.com/mt-shihab26/vite-plugin-boilerplate#readme",
    "bugs": {
        "url": "https://github.com/mt-shihab26/vite-plugin-boilerplate/issues"
    },
    "keywords": [
        "vite",
        "vite-plugin",
        "react",
        "vue",
        "scaffold"
    ],
    "scripts": {
        "prepublishOnly": "bun run build",
        "build": "tsup",
        "dev": "tsup --watch",
        "test": "vitest run",
        "format": "prettier --write .",
        "release": "npm version patch && npm publish && git push && git push --tags"
    },
    "peerDependencies": {
        "vite": ">=4.0.0"
    },
    "devDependencies": {
        "@types/node": "^25.9.2",
        "prettier": "^3.8.3",
        "tsup": "^8.0.0",
        "typescript": "^5.0.0",
        "vite": "^6.0.0",
        "vitest": "^4.1.8"
    }
}
